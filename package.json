{
  "name": "3d-soccer-game-engine",
  "version": "1.0.0",
  "description": "A fully functional 3D soccer game (FIFA/EA Sports FC style) built with HTML5, JavaScript, and Three.js. Features arcade-simulation hybrid physics, responsive player controls, AI opponents, and realistic ball mechanics.",
  "main": "main.js",
  "scripts": {
    "start": "python -m http.server 8000",
    "start-node": "npx http-server -p 8000",
    "dev": "npx http-server -p 8000 -c-1",
    "build": "echo 'No build step required - pure vanilla JS'",
    "test": "echo 'Testing framework not yet implemented'"
  },
  "keywords": [
    "soccer",
    "football",
    "3D-game",
    "game-engine",
    "Three.js",
    "JavaScript",
    "WebGL",
    "arcade",
    "simulation",
    "physics",
    "AI",
    "FIFA",
    "EA-Sports",
    "multiplayer-ready"
  ],
  "author": {
    "name": "berabera54152",
    "email": "berabera54152@gmail.com",
